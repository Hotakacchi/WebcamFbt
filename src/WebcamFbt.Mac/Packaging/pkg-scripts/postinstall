#!/bin/sh
# インストールの後に、「インターネットから入手したもの」の印（quarantine）が付いていれば外す。
# 署名（ad-hoc）はビルド時に済ませてあるので、ここではしない。
# $2 = インストール先（/Applications）
APP="$2/WebcamFbt.app"
if [ -d "$APP" ]; then
    xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true
    # Finder や Dock が前の版（アイコンが無かった版）の見た目を覚えたままにならないよう、更新したことを知らせる
    touch "$APP"
fi
exit 0
