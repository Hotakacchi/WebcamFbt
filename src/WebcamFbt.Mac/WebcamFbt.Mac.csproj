<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mac 版（Avalonia）。Windows 版（WebcamFbt.App、WPF）とは別のアプリで、Core・Osc・Vision を共有する。
    配布用の .app は scripts\build-mac.ps1 で osx-arm64 / osx-x64 ごとに作る。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WebcamFbt</AssemblyName>
    <RootNamespace>WebcamFbt.Mac</RootNamespace>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    開発用: Windows で `dotnet run` して画面と処理の流れを確かめるときだけ、Windows 版の OpenCV を足す
    （Vision の net10.0 向けは macOS 版の OpenCV しか持たないため）。配布ビルド（osx-*）には入らない。
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT' and !$(RuntimeIdentifier.StartsWith('osx'))">
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <!-- .icns は .app の Contents/Resources に入れる（build-mac-pkg.sh / build-mac.ps1）ので埋め込まない -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.icns" />
  </ItemGroup>

  <!--
    Windows 版の ViewModel のうち WPF に依存しない部分は、同じファイルをそのままコンパイルして共有する
    （トラッキング・OSC、カメラの校正、手順ガイドと状態表示、設定の保存）。機能と文言が Windows 版と自動でそろう。
    カメラ・プレビュー部分（MainViewModel.cs、MainViewModel.Camera2.cs）は画像の型が違うので Mac 版に写してある。
  -->
  <ItemGroup>
    <Compile Include="..\WebcamFbt.App\ViewModels\MainViewModel.Tracking.cs" Link="ViewModels\Shared\MainViewModel.Tracking.cs" />
    <Compile Include="..\WebcamFbt.App\ViewModels\MainViewModel.CameraCalibration.cs" Link="ViewModels\Shared\MainViewModel.CameraCalibration.cs" />
    <Compile Include="..\WebcamFbt.App\ViewModels\MainViewModel.Guide.cs" Link="ViewModels\Shared\MainViewModel.Guide.cs" />
    <Compile Include="..\WebcamFbt.App\ViewModels\MainViewModel.Settings.cs" Link="ViewModels\Shared\MainViewModel.Settings.cs" />
    <Compile Include="..\WebcamFbt.App\ViewModels\MainViewModel.Updates.cs" Link="ViewModels\Shared\MainViewModel.Updates.cs" />
    <!-- 版の表示（ウィンドウのタイトル・右パネルの下・メニューバーのアイコンの説明） -->
    <Compile Include="..\WebcamFbt.App\AppInfo.cs" Link="Shared\AppInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebcamFbt.Core\WebcamFbt.Core.csproj" />
    <ProjectReference Include="..\WebcamFbt.Osc\WebcamFbt.Osc.csproj" />
    <ProjectReference Include="..\WebcamFbt.Vision\WebcamFbt.Vision.csproj" />
  </ItemGroup>
</Project>
