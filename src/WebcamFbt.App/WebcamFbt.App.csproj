<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイのアイコン（NotifyIcon）にだけ Windows Forms を使う -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WebcamFbt</AssemblyName>
    <RootNamespace>WebcamFbt.App</RootNamespace>
    <!-- Linux 等でビルドだけ確認したい場合のため -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- アイコンは scripts\make-icon.ps1 で作る -->
    <ApplicationIcon>Assets\WebcamFbt.ico</ApplicationIcon>
    <!-- DirectML のデバッグ用 DLL（大きい）は要らない -->
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
    <!--
      DirectML.dll（再配布版）を出力に入れるため、x64 のこのプロジェクトから直接参照する。
      ONNX Runtime 経由（Vision は AnyCPU）だと DirectML のパッケージがコピーしないので、Windows に入っている
      DirectML が使われてしまい、古い Windows 10 では GPU 推論に失敗する。版は ONNX Runtime 1.24.4 が依存するものに合わせる。
      単一 exe でも、ONNX Runtime は展開先の同じフォルダの DirectML.dll を読む（確認済み）。
    -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Forms と System.Drawing の名前空間は自動では読み込まない（WPF の Application・Color などと名前がぶつかるため） -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ウィンドウ（タスクバー）とタスクトレイのアイコン -->
    <Resource Include="Assets\WebcamFbt.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebcamFbt.Core\WebcamFbt.Core.csproj" />
    <ProjectReference Include="..\WebcamFbt.Osc\WebcamFbt.Osc.csproj" />
    <ProjectReference Include="..\WebcamFbt.Vision\WebcamFbt.Vision.csproj" />
  </ItemGroup>
</Project>
