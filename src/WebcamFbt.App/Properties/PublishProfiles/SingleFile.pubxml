<?xml version="1.0" encoding="utf-8"?>
<!--
  配布用の単一 exe（フェーズ 5c）。
  dotnet publish src\WebcamFbt.App -p:PublishProfile=SingleFile
  - self-contained: .NET が入っていない PC でも動く
  - ネイティブ DLL（ONNX Runtime・DirectML・OpenCV・WPF）も exe に入れ、初回起動時に一時フォルダへ展開する
  - トリミングはしない（WPF とリフレクションを使うライブラリが壊れるため）
  - モデルは同梱しない（初回起動時にダウンロード。THIRD_PARTY_NOTICES.md の注意事項を参照）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
