<Window x:Class="WebcamFbt.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WebcamFbt.App.ViewModels"
        xmlns:views="clr-namespace:WebcamFbt.App.Views"
        xmlns:app="clr-namespace:WebcamFbt.App"
        Title="{x:Static app:AppInfo.WindowTitle}"
        Icon="/Assets/WebcamFbt.ico"
        Width="1280" Height="760" MinWidth="900" MinHeight="560"
        Background="#FF121316">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- 状態表示 1 つ分（色付きの点＋名前）。緑=正常、黄=注意、赤=見えていない・エラー、灰=オフ -->
        <DataTemplate x:Key="IndicatorTemplate" DataType="{x:Type vm:StatusIndicator}">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource OffBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" Foreground="#FFE6E6E6" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Good">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warn">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Bad">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource BadBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- プレビュー -->
        <Grid Grid.Column="0" Margin="12">
            <!-- 単眼プレビュー（1台モード） -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TwoCameraMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="Black" CornerRadius="6">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                </Border>
                <TextBlock Text="「開始」を押すとカメラ映像が表示されます"
                           Foreground="{StaticResource SubTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 統計情報（左上に重ねて表示） -->
                <Border Background="#AA000000" CornerRadius="4" Padding="10,6"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                    <TextBlock Text="{Binding StatsText}" Foreground="#FFE6E6E6"
                               FontFamily="Consolas, BIZ UDGothic, Meiryo" FontSize="13" />
                </Border>
                <!-- トラッカーの値（左下に重ねて表示） -->
                <Border Background="#AA000000" CornerRadius="4" Padding="10,6"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrackingText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Indicators}" ItemTemplate="{StaticResource IndicatorTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding TrackingText}" Foreground="#FFE6E6E6"
                                   FontFamily="Consolas, BIZ UDGothic, Meiryo" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2台プレビュー（ステレオモード。4a では三角測量はせず各カメラの2Dを表示） -->
            <Grid Visibility="{Binding TwoCameraMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- カメラ1（トラッキングに使用） -->
                <Grid Grid.Column="0" Margin="0,0,6,0">
                    <Border Background="Black" CornerRadius="6">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                    </Border>
                    <Border Background="#AA000000" CornerRadius="4" Padding="8,4"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                        <TextBlock Text="{Binding StatsText}" Foreground="#FFE6E6E6"
                                   FontFamily="Consolas, BIZ UDGothic, Meiryo" FontSize="12" />
                    </Border>
                    <Border Background="#AA1E6FEB" CornerRadius="4" Padding="8,3"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                        <TextBlock Text="カメラ1" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <Border Background="#AA000000" CornerRadius="4" Padding="8,4"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrackingText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Indicators}" ItemTemplate="{StaticResource IndicatorTemplate}"
                                          ItemsPanel="{StaticResource HorizontalPanel}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding TrackingText}" Foreground="#FFE6E6E6"
                                       FontFamily="Consolas, BIZ UDGothic, Meiryo" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- カメラ2（プレビュー＋2Dのみ） -->
                <Grid Grid.Column="1" Margin="6,0,0,0">
                    <Border Background="Black" CornerRadius="6">
                        <Image Source="{Binding PreviewImage2}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                    </Border>
                    <Border Background="#AA000000" CornerRadius="4" Padding="8,4"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                        <TextBlock Text="{Binding StatsText2}" Foreground="#FFE6E6E6"
                                   FontFamily="Consolas, BIZ UDGothic, Meiryo" FontSize="12" />
                    </Border>
                    <Border Background="#AA1E6FEB" CornerRadius="4" Padding="8,3"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                        <TextBlock Text="カメラ2" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </Grid>
            </Grid>

            <!-- カメラの校正中の案内（上の中央に重ねて表示。校正中はトラッキングが止まることをはっきり出す） -->
            <Border Background="#E6182A4A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="14,10" Margin="0,14,0,0" MaxWidth="560"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Visibility="{Binding IsCameraCalibrating, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="カメラの校正中 — トラッキングは止まっています" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding CameraCalibrationText}" Foreground="#FFE6E6E6" Margin="0,4,0,0"
                                   FontFamily="Consolas, BIZ UDGothic, Meiryo" />
                        <TextBlock Text="{Binding CameraCalibrationHint}" Foreground="#FFE6E6E6" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="中止するか 15 枚そろうと、トラッキングに戻ります" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="中止" Command="{Binding CancelCameraCalibrationCommand}"
                            VerticalAlignment="Top" Margin="12,0,0,0" Padding="14,4" />
                </Grid>
            </Border>

            <!-- 上から見たトラッカー（右下に重ねて表示。実行中だけ） -->
            <views:TrackerTopDownView Frame="{Binding TopDownFrame}" Width="170" Height="180"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- 設定パネル -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}">
            <DockPanel Margin="16,8,16,16">
                <StackPanel DockPanel.Dock="Bottom">
                    <ProgressBar Height="4" Maximum="1" Value="{Binding Progress}" Margin="0,0,0,8">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource SubTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="{Binding StartStopLabel}" Command="{Binding StartStopCommand}"
                            Height="40" FontSize="15" />
                    <!-- 版（マウスを乗せるとコミットまで含む版） -->
                    <TextBlock Text="{x:Static app:AppInfo.DisplayName}" ToolTip="{x:Static app:AppInfo.VersionDetail}"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,6,0,0" />
                </StackPanel>

                <!-- 新しい版のお知らせ（あるときだけ） -->
                <Border DockPanel.Dock="Top" Background="#FF1E3A6B" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateBannerText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="ダウンロードのページを開く" Command="{Binding OpenUpdatePageCommand}" Height="26" />
                            <Button Grid.Column="1" Content="あとで" Command="{Binding DismissUpdateCommand}" Height="26" Margin="4,0,0,0" Padding="8,0" />
                            <Button Grid.Column="2" Content="通知しない" Command="{Binding SkipUpdateCommand}" Height="26" Margin="4,0,0,0" Padding="8,0"
                                    ToolTip="この版は通知しない（もっと新しい版が出たら知らせる）" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 手順ガイド（済んだ段階に ✓、次にやる段階を強調。押すと設定のタブを開く） -->
                <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="8,6" Margin="0,8,0,4">
                    <ItemsControl ItemsSource="{Binding GuideSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GuideStep}">
                                <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Badge" Width="20" Height="20" CornerRadius="10" Background="{StaticResource OffBrush}"
                                                VerticalAlignment="Top" Margin="0,1,8,0">
                                            <TextBlock x:Name="BadgeText" Text="{Binding Number}" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="Title" Text="{Binding Title}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                            <TextBlock x:Name="Hint" Text="{Binding Hint}" Foreground="{StaticResource SubTextBrush}" FontSize="10.5"
                                                       TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource GoodBrush}" />
                                        <Setter TargetName="BadgeText" Property="Text" Value="✓" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TabControl SelectedIndex="{Binding SelectedSettingsTab}">
                <!-- ===== カメラ ===== -->
                <TabItem Header="カメラ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="カメラ" Style="{StaticResource SectionHeader}" />
                        <StackPanel IsEnabled="{Binding CanEditSettings}">
                            <TextBlock Text="デバイス" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" />
                            <TextBlock Text="解像度" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding SelectedResolution}" />
                            <TextBlock Text="フレームレート" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding FpsChoices}" SelectedItem="{Binding SelectedFps}" />
                            <TextBlock Text="取得方式" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding BackendChoices}" SelectedItem="{Binding SelectedBackend}" />
                            <CheckBox Content="カメラを2台使う（ステレオ）" IsChecked="{Binding TwoCameraMode}"
                                      Foreground="{StaticResource TextBrush}" Margin="0,10,0,0" />
                            <StackPanel Visibility="{Binding TwoCameraMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="カメラ2 デバイス（解像度・fps はカメラ1と同じ）" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera2}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="推論" Style="{StaticResource SectionHeader}" />
                        <StackPanel IsEnabled="{Binding CanEditSettings}">
                            <TextBlock Text="実行デバイス" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding DeviceChoices}" SelectedItem="{Binding SelectedDevice}" />
                        </StackPanel>

                        <TextBlock Text="表示" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="信頼度のしきい値: " /><Run Text="{Binding ScoreThreshold, StringFormat=F2, Mode=OneWay}" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding ScoreThreshold}" />
                        <CheckBox Content="左右反転して表示（鏡モード）" IsChecked="{Binding MirrorPreview}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,10,0,0" />
                        <CheckBox Content="プレビューを表示（オフで少し軽くなる）" IsChecked="{Binding PreviewEnabled}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />

                        <TextBlock Text="アプリ" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="新しい版が出たら知らせる" IsChecked="{Binding CheckForUpdates}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="1 日に 1 回、GitHub に新しい版があるか問い合わせます（送るのはアプリ名と版だけです）。"
                                   Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="今すぐ確認" Command="{Binding CheckUpdatesNowCommand}" Height="26" Padding="10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdateStatusText}" Foreground="{StaticResource SubTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                </TabItem>

                <!-- ===== トラッキング ===== -->
                <TabItem Header="トラッキング">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="体とカメラ" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="2台のときは三角測量で3D化する（ステレオ校正が必要）" IsChecked="{Binding UseStereoTracking}"
                                  Visibility="{Binding TwoCameraMode, Converter={StaticResource BoolToVisibility}}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="身長: " /><Run Text="{Binding HeightMeters, StringFormat=F2, Mode=OneWay}" /><Run Text=" m" />
                        </TextBlock>
                        <Slider Minimum="1.2" Maximum="2.1" SmallChange="0.01" LargeChange="0.05"
                                TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding HeightMeters}" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="カメラの水平画角: " /><Run Text="{Binding HorizontalFov, StringFormat=F0, Mode=OneWay}" /><Run Text="°" />
                        </TextBlock>
                        <Slider Minimum="40" Maximum="120" SmallChange="1" LargeChange="5"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HorizontalFov}" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="カメラの傾き（下向きが +）: " /><Run Text="{Binding CameraPitch, StringFormat=F0, Mode=OneWay}" /><Run Text="°" />
                        </TextBlock>
                        <Slider Minimum="-45" Maximum="45" SmallChange="1" LargeChange="5"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CameraPitch}" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="トラッキングに使う信頼度: " /><Run Text="{Binding TrackingThreshold, StringFormat=F2, Mode=OneWay}" />
                        </TextBlock>
                        <Slider Minimum="0.1" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding TrackingThreshold}" />

                        <TextBlock Text="体のキャリブレーション（T ポーズ）" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="カメラの方を向いて T ポーズ（全身が映る位置）で立ち、ボタンを押してください。数秒ぶん測って体の比率・床の高さ・正面方向を合わせます。"
                                   Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontSize="11" />
                        <Button Content="キャリブレーション開始" Command="{Binding CalibrateCommand}"
                                Margin="0,8,0,0" Height="30" />
                        <Button Content="解除（既定値に戻す）" Command="{Binding ClearCalibrationCommand}"
                                Margin="0,6,0,0" Height="26" />
                        <TextBlock Text="{Binding CalibrationText}" Foreground="{StaticResource SubTextBrush}"
                                   FontFamily="Consolas, BIZ UDGothic, Meiryo" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Expander Header="詳細: 平滑化（One Euro Filter）" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0">
                        <StackPanel>
                        <TextBlock Text="min cutoff を下げる → 静止時のブレが減る（遅れる）&#x0a;beta を上げる → 速い動きの遅れが減る（ブレやすい）"
                                   Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontSize="11" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="位置 min cutoff: " /><Run Text="{Binding PositionMinCutoff, StringFormat=F2, Mode=OneWay}" /><Run Text=" Hz" />
                        </TextBlock>
                        <Slider Minimum="0.05" Maximum="5" SmallChange="0.05" LargeChange="0.25" Value="{Binding PositionMinCutoff}" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="位置 beta: " /><Run Text="{Binding PositionBeta, StringFormat=F2, Mode=OneWay}" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.25" Value="{Binding PositionBeta}" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="回転 min cutoff: " /><Run Text="{Binding RotationMinCutoff, StringFormat=F2, Mode=OneWay}" /><Run Text=" Hz" />
                        </TextBlock>
                        <Slider Minimum="0.05" Maximum="5" SmallChange="0.05" LargeChange="0.25" Value="{Binding RotationMinCutoff}" />
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="回転 beta: " /><Run Text="{Binding RotationBeta, StringFormat=F2, Mode=OneWay}" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.25" Value="{Binding RotationBeta}" />
                        <Button Content="初期値に戻す" Command="{Binding ResetFilterParamsCommand}" Margin="0,8,0,0" Height="26" />
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                </TabItem>

                <!-- ===== 校正 ===== -->
                <TabItem Header="校正">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="カメラの校正（チェッカーボード）" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="印刷したチェッカーボードをカメラに向け、位置と傾きを変えながら毎回少し止めます。2台のときは両方に写る位置で。1マスの大きさは定規で測った値を入れてください。"
                                   Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontSize="11" />
                        <TextBlock Text="校正中はトラッキングが止まります（中止するか 15 枚そろうと戻ります）。先にボードを用意してから「開始」→「校正を開始」を押してください。"
                                   Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                        <Button Content="印刷用のボードを保存（今の交点の数で作る）" Command="{Binding SaveCheckerboardImageCommand}"
                                Height="26" Margin="0,6,0,0" />
                        <Grid IsEnabled="{Binding CanEditBoard}" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="交点（横）" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding BoardInnerCols}" Height="24" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                <TextBlock Text="交点（縦）" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding BoardInnerRows}" Height="24" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="1マス [mm]" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding BoardSquareMm}" Height="24" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 「開始」していないとき・校正中は押せない -->
                            <Button Grid.Column="0" Content="校正を開始" Command="{Binding StartCameraCalibrationCommand}" Height="30">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCameraCalibrating}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Content="中止" Command="{Binding CancelCameraCalibrationCommand}"
                                    Height="30" Margin="4,0,0,0" Padding="12,0" />
                        </Grid>
                        <TextBlock Text="{Binding CameraCalibrationText}" Foreground="{StaticResource SubTextBrush}"
                                   FontFamily="Consolas, BIZ UDGothic, Meiryo" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding CameraCalibrationHint}" Foreground="{StaticResource TextBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
                </TabItem>

                <!-- ===== VRChat ===== -->
                <TabItem Header="VRChat">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="VRChat（OSC）" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="VRChat に送信する" IsChecked="{Binding OscEnabled}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                        <CheckBox Content="頭の位置を送る（位置合わせ用）" IsChecked="{Binding SendHeadPosition}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="送信先（Quest 単体なら Quest の IP）" Style="{StaticResource Label}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OscHost, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding OscPort, UpdateSourceTrigger=PropertyChanged}" Height="24" Margin="4,0,0,0" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="反映" Command="{Binding ApplyOscEndpointCommand}" Margin="4,0,0,0" Padding="10,0" />
                        </Grid>
                        <Button Content="向きを合わせる（カメラの方を向いて押す）" Command="{Binding AlignYawCommand}"
                                Margin="0,10,0,0" Height="30" />
                    </StackPanel>
                </ScrollViewer>
                </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
